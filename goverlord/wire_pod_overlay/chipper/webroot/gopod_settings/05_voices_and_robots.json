{
  "gemma_eyes": {
    "skip_frames": 15,
    "keep_minutes": 10,
    "safeguard": false
  },
  "touch_interrupt": {
    "off_file": "gopod_touch_interrupt_off"
  },
  "native_intent": {
    "role": "Terminal",
    "once_seconds": 3
  },
  "gopod_yourself": {
    "phrases": ["GOPOD Yourself"],
    "repeat_seconds": 10
  },
  "song_stop": {
    "request_file": "gopod_song_stop_request",
    "wait_seconds": 45,
    "stop_words": ["stop run"],
    "safe_script": "gopod_probes/tools/stop-bingo-test-safe.sh"
  },
  "native": {
    "on_at_start": true,
    "always_on": ["intent_names_ask"],
    "to_manager": {"intent_weather_extend": "weather", "intent_clock_time": "time_place"}
  },
  "mic_service": {
    "about": "One process owns the Jetson's USB room mic for both Record Session's master and the numpad push-to-talk (the mic can only be opened once). Started by Wire-Pod on first use, as the desktop user. It reuses the golden \"Is That You\" PTT writer's mic pick, timings, 48 kHz / 16 kHz resample and Vosk model (gopod_mic_service_001.py).",
    "script": "gopod_probes/tools/gopod_mic_service_001.py"
  },
  "numpad_ptt": {
    "body_to_brobot": {
      "Vector 1": "Brobot 1",
      "Vector 2": "Brobot 2"
    },
    "min_hold_seconds": 1.0,
    "release_tail_seconds": 0.9,
    "max_hold_seconds": 30,
    "exit_taps": 3,
    "exit_window_seconds": 2.0,
    "all_hold_seconds": 0.5,
    "all_label": "All",
    "key_sound": {"file": "", "volume": "40%"},
    "mic_usb_ids": ["3302:12e9"],
    "numpad_usb_ids": ["1a2c:4324"],
    "layout": "usb",
    "usb_watch_seconds": 3,
    "usb_host": "GIT REPO",
    "mic_disabled_seconds": 1.2,
    "error_texts": ["too_short", "nothing_heard", "no_mic", "not_ready", "wait_message", "error", "numlock_off", "not_live"]
  },
  "record_session": {
    "sessions_dir": "~/gopod_tts/sessions",
    "folder_suffix": "_brobots_session",
    "max_minutes": 120,
    "answer_wait_minutes": 10,
    "keep_words": [
      "keep",
      "session",
      "recording"
    ],
    "delete_words": [
      "delete",
      "session",
      "recording"
    ],
    "answer_to": "Goverlord",
    "ask_brobot": "Goverlord",
    "confirm_brobot": "Brobot 2",
    "take_sheet": "~/gopod_tts/sessions/harvest/take_sheet.json"
  },
  "run_check": {
    "file": "~/crushn8r_git/gopod_notes/run_checks/run_check_last.json",
    "mute_marker": "run_check:mute",
    "unmute_marker": "run_check:unmute",
    "skip_prefixes": ["heard:", "loop_pause", "loop_resume"],
    "replay_wait_seconds": 90
  },
  "robots_off": {
    "on": false,
    "capture_file": "gopod_probes/demo_runs/robots_off_capture_{date}.jsonl",
    "voices": {"Brobot 1": "am_michael", "Brobot 2": "am_puck"}
  },
  "battery_watch": {
    "enabled": true,
    "interval_seconds": 15,
    "low_volts": 3.7,
    "recover_volts": 3.8,
    "dip_volts": 0.15,
    "back_after_misses": 2,
    "guards": {"Brobot 1": "INTEL 404 PNFH", "Brobot 2": "INTEL 404 PNFT"}
  },
